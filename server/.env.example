NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=mongodb+srv://APPLICATION_USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/loveraf?retryWrites=true&w=majority&appName=Loveraf
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=loveraf-api
APP_ORIGINS=https://loveraf.com,https://www.loveraf.com
OTP_HMAC_SECRET=replace-with-another-long-random-secret
# Gmail SMTP requires Google 2-Step Verification and a dedicated 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_SMS_ENDPOINT=
OTP_EMAIL_ENDPOINT=
PROVIDER_BRIDGE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
